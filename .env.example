# hestia-template — Beispielkonfiguration
# Kopiere diese Datei nach `.env` und fülle die Werte aus. `.env` wird nie committet.

# --- Home Assistant (Standardplattform) ---
HASS_URL=http://homeassistant.local:8123
HASS_TOKEN=

# --- IKEA DIRIGERA Hub (optional; nur bei IKEA-Hardware) ---
DIRIGERA_IP=
DIRIGERA_TOKEN=

# --- Sonos (optional; sonst SSDP-Discovery) ---
SONOS_IPS=
